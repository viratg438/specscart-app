{
  "expo": {
    "name": "specscartApp",
    "slug": "specscart-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/favicon.png",
    "scheme": "specscartapp",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow Specscart to use the camera so you can virtually try on frames.",
        "NSSpeechRecognitionUsageDescription": "Allow Specscart to use speech recognition so you can search by voice.",
        "NSMicrophoneUsageDescription": "Allow Specscart to use the microphone so you can search by voice."
      }
    },
    "android": {
      "package": "com.viratg438.specscartapp",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Specscart to use the camera so you can virtually try on frames."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/favicon.png",
          "imageWidth": 76
        }
      ],
      "expo-asset",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Specscart to use the microphone so you can search by voice.",
          "speechRecognitionPermission": "Allow Specscart to use speech recognition so you can search by voice."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d0831cf7-b622-4612-8e29-ba37e6ddbcac"
      }
    },
    "owner": "viratg438gmailcom"
  }
}
